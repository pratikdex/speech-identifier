{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server/cmd/server",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${userHome}/.config/gcloud/application_default_credentials.json"
      }
    }
  ]
}
